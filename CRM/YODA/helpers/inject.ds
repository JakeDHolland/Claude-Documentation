// /**
//  * FUNCTION: inject
//  * ─────────────────────────────────────────────────────────────
//  * @desc    Writes a value into a nested map at a slash-delimited
//  *          path, creating intermediate maps as needed. Used by
//  *          the translate helper to build the output payload.
//  *
//  * @trigger Called internally — not triggered directly by CRM
//  *
//  * @param   path  {String} — Slash-delimited destination path
//  *                           e.g. "attributes/companyName"
//  * @param   data  {Map}    — The object to inject into
//  * @param   value {Any}    — The value to write at the path
//  *
//  * @returns {Map} — The modified data map
//  *
//  * @depends extract
//  *
//  * @flow
//  *   1. Split path into accessors
//  *   2. Iterate in reverse, wrapping the value in a map at each level
//  *   3. Use extract to fetch any existing data at each level
//  *      so existing keys are preserved
//  *   4. Return the fully reconstructed map
//  *
//  * @authors  Dash Bunyan (original)
//  *           Jake Holland (contributor)
//  *
//  * @updated  DD/MM/YYYY — Description of change
//  * ─────────────────────────────────────────────────────────────
//  */
data = IF(data == "" || data == null,Map(),data).toMap();
//
accessors = path.toList("/");
//
result = value;
last_index = accessors.size() - 1;
for each index i in accessors
{
	index = last_index - i;
	head = accessors.get(index);
	//
	tail = accessors.subList(0,index).toString("/");
	//
	// Preserve existing keys at this level before adding the new value
	extract = standalone.extract(tail,data);
	container = IF(extract == "" || extract == null,Map(),extract).toMap();
	//
	container.put(head,result);
	//
	result = container;
}
//
return result;
