// /**
//  * FUNCTION: yoda_call_api
//  * ─────────────────────────────────────────────────────────────
//  * @desc    Constructs the full Yoda API URL from settings and
//  *          executes the HTTP request using the appropriate Zoho
//  *          named connection. Supports GET, POST, and PUT.
//  *          Automatically switches between live and test
//  *          connections based on the active sync_version.
//  *
//  * @trigger Called internally — not triggered directly by CRM
//  *
//  * @param   path    {String} — API endpoint path e.g. "companies",
//  *                             "addresses/42", or "token"
//  * @param   method  {String} — HTTP method: "GET", "POST", or "PUT"
//  * @param   body    {Map}    — Request body (ignored for GET)
//  * @param   headers {Map}    — Additional headers (auth is handled
//  *                             via Zoho named connection)
//  *
//  * @returns {Map} — Raw Yoda API response
//  *
//  * @depends yoda_get_intergration_settings
//  *
//  * @flow
//  *   1. Load credentials from settings
//  *   2. Build full URL from protocol + environment + domain + root + path
//  *      (root is omitted for the special "token" path)
//  *   3. Select Zoho connection: "yoda_live" or "yodatest"
//  *   4. Execute invokeurl with the correct method and connection
//  *   5. Return raw response
//  *
//  * @authors  Jake Holland (original)
//  *
//  * @updated  DD/MM/YYYY — Description of change
//  * ─────────────────────────────────────────────────────────────
//  */
settings = standalone.yoda_get_intergration_settings();
credentials = settings.get("credentials");
//
// Build the base URL from environment settings
sync_status = credentials.get("sync_version");
yoda_enviroment = credentials.get(sync_status);
yoda_protocol = credentials.get("protocol");
yoda_domain = credentials.get("domain");
yoda_root = credentials.get("root");
//
url = yoda_protocol + yoda_enviroment + yoda_domain;
//
// The "token" endpoint sits at the domain root — no API root prefix needed
if(path == "token")
{
	url = url + path;
}
else
{
	url = (url + yoda_root) + path;
}
//
info "==Call API=====";
info "method:" + method;
info "url: " + url;
info "body: " + body;
info "headers: " + headers;
//
// Execute the request using the correct connection for the active environment
// invokeurl requires a literal type value so we branch on method
if(sync_status == "live_enviroment")
{
	if(method == "POST")
	{
		response = invokeurl
		[
			url :url
			type :POST
			parameters:body.toString()
			connection:"yoda_live"
		];
	}
	else if(method == "GET")
	{
		response = invokeurl
		[
			url :url
			type :GET
			parameters:body
			connection:"yoda_live"
		];
	}
	else if(method == "PUT")
	{
		response = invokeurl
		[
			url :url
			type :PUT
			parameters:body.toString()
			connection:"yoda_live"
		];
	}
}
else
{
	if(method == "POST")
	{
		response = invokeurl
		[
			url :url
			type :POST
			parameters:body.toString()
			connection:"yodatest"
		];
	}
	else if(method == "GET")
	{
		response = invokeurl
		[
			url :url
			type :GET
			parameters:body
			connection:"yodatest"
		];
	}
	else if(method == "PUT")
	{
		response = invokeurl
		[
			url :url
			type :PUT
			parameters:body.toString()
			connection:"yodatest"
		];
	}
}
info "========";
//
return response;
