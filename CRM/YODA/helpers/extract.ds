// /**
//  * FUNCTION: extract
//  * ─────────────────────────────────────────────────────────────
//  * @desc    Reads a value from a nested map or list using a
//  *          slash-delimited path string. Supports array index
//  *          access using square bracket notation.
//  *
//  * @trigger Called internally — not triggered directly by CRM
//  *
//  * @param   path {String} — Slash-delimited path to the value.
//  *                          Use [N] for array index access.
//  *                          e.g. "attributes/totals/GBP"
//  *                          e.g. "items/[0]/name"
//  *                          Pass null or "" to return data as-is.
//  * @param   data {Map|List} — The source object to traverse
//  *
//  * @returns {Any} — The value at the path, or null if not found
//  *
//  * @depends none
//  *
//  * @flow
//  *   1. Default result to the full data object
//  *   2. Split path into accessors on "/"
//  *   3. For each accessor: if "[N]" convert to list and get by index,
//  *      otherwise get by map key
//  *   4. Return result
//  *
//  * @authors  Jake Holland (original)
//  *
//  * @updated  DD/MM/YYYY — Description of change
//  * ─────────────────────────────────────────────────────────────
//  */
result = data;
//
if(path != null && path != "")
{
	accessors = path.toList("/");
	for each  accessor in accessors
	{
		if(accessor.startsWith("["))
		{
			// Array index access — extract the integer from [N]
			index = accessor.getAlphaNumeric().removeAllAlpha().toLong();
			items = IFNULL(result,List()).toList();
			result = IF(items.size() > index,items.get(index),null);
		}
		else
		{
			// Map key access
			item = IFNULL(result,Map()).toString().toMap();
			result = item.get(accessor);
		}
	}
}
//
return result;
