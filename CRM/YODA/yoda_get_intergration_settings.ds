// /**
//  * FUNCTION: yoda_get_intergration_settings
//  * ─────────────────────────────────────────────────────────────
//  * @desc    Returns the central settings map used by all Yoda
//  *          integration functions. Contains environment URLs,
//  *          the active environment selector, field mappings for
//  *          each CRM module, and API path aliases.
//  *
//  *          To switch environments, change sync_version to point
//  *          to the desired environment key:
//  *            "live_enviroment" → api.beautynet.co  (production)
//  *            "uat_enviroment"  → apiuat.beautynet.co
//  *            "test_enviroment" → apitest.beautynet.co
//  *
//  * @trigger Called internally — not triggered directly by CRM
//  *
//  * @param   none
//  *
//  * @returns {Map} — Settings map with keys:
//  *                  credentials, mapping, path
//  *
//  * @depends none
//  *
//  * @flow
//  *   1. Define credentials (environment URLs and active selector)
//  *   2. Define field mappings for Accounts, Contacts, Addresses
//  *   3. Define module path aliases (CRM name ↔ Yoda endpoint)
//  *   4. Return settings map
//  *
//  * @authors  Jake Holland (original)
//  *
//  * @updated  DD/MM/YYYY — Description of change
//  * ─────────────────────────────────────────────────────────────
//  */
settings = {
	"credentials":
	{
			// Change sync_version to switch the active environment
			"sync_version":"live_enviroment",
			"test_enviroment":"apitest",
			"uat_enviroment":"apiuat",
			"live_enviroment":"api",
			"protocol":"https://",
			"domain":".beautynet.co/",
			"root":"api/v1/"
		},
		"mapping":
		{
			"Accounts":{
			{
				"crm":{"path":"Account_Name","type":"string"},
				"yoda":{"path":"companyName","type":"string","nullable":true}
			},
			{
				"crm":{"path":"Currency","type":"string"},
				"yoda":{"path":"currency","type":"string","nullable":true}
			},
			{
				"crm":{"path":"Company_Number","type":"string"},
				"yoda":{"path":"companyNumber","type":"string","nullable":true}
			},
			{
				"crm":{"path":"Account_Type","type":"string"},
				"yoda":{"path":"companyType","type":"string","nullable":true}
			},
			{
				"crm":{"path":"VAT_number","type":"string"},
				"yoda":{"path":"vatNumber","type":"string","nullable":true}
			},
			{
				"crm":{"path":"EORI_Number","type":"string"},
				"yoda":{"path":"eoriNumber","type":"string","nullable":true}
			},
			{
				"crm":{"path":"Tax_Code","type":"string"},
				"yoda":{"path":"taxCode","type":"string","nullable":true}
			},
			{
				"crm":{"path":"Dutch_VAT_Term","type":"string"},
				"yoda":{"path":"dutchVatTerm","type":"string","nullable":true}
			},
			{
				"crm":{"path":"Operating_Region","type":"string"},
				"yoda":{"path":"regionOfOperation","type":"string","nullable":true}
			},
			{
				"crm":{"path":"Phone","type":"number"},
				"yoda":{"path":"phoneNumber","type":"number","nullable":true}
			},
			{
				"crm":{"path":"Credit_Limit","type":"number"},
				"yoda":{"path":"creditLimit","type":"number","nullable":true}
			},
			{
				"crm":{"path":"id","type":"string"},
				"yoda":{"path":"crmId","type":"string","nullable":true}
			},
			{
				"crm":{"path":"Customer","type":"boolean"},
				"yoda":{"path":"isCustomer","type":"boolean","nullable":true}
			},
			{
				"crm":{"path":"Supplier","type":"boolean"},
				"yoda":{"path":"isSupplier","type":"boolean","nullable":true}
			},
			{
				"crm":{"path":"Company_Email","type":"string"},
				"yoda":{"path":"emailAddress","type":"string","nullable":true}
			},
			{
				"crm":{"path":"deliveryTerm","type":"string"},
				"yoda":{"path":"deliveryTerm","type":"string","nullable":true}
			},
			{
				"crm":{"path":"paymentTerm","type":"string"},
				"yoda":{"path":"paymentTerm","type":"string","nullable":true}
			},
			{
				"crm":{"path":"defaultSalesperson","type":"string"},
				"yoda":{"path":"defaultSalesperson","type":"string","nullable":true}
			}
		},
		"Contacts":{
		{
			"crm":{"path":"Primary_Contact","type":"boolean"},
			"yoda":{"path":"isPrimary","type":"boolean","nullable":true}
		},
		{
			"crm":{"path":"Full_Name","type":"string"},
			"yoda":{"path":"fullName","type":"string","nullable":true}
		},
		{
			"crm":{"path":"Email","type":"string"},
			"yoda":{"path":"emailAddress","type":"string","nullable":true}
		},
		{
			"crm":{"path":"id","type":"string"},
			"yoda":{"path":"crmId","type":"string","nullable":true}
		},
		{
			"crm":{"path":"company_yoda_id","type":"string"},
			"yoda":{"path":"company","type":"string","nullable":true}
		}
	},
	"Addresses":
	{
		{
			"crm":{"path":"Primary","type":"boolean"},
			"yoda":{"path":"isPrimary","type":"boolean","nullable":true}
		},
		{
			"crm":{"path":"address_type","type":"integer"},
			"yoda":{"path":"addressType","type":"integer","nullable":true}
		},
		{
			"crm":{"path":"Street_1","type":"string"},
			"yoda":{"path":"addressLineOne","type":"string","nullable":true}
		},
		{
			"crm":{"path":"Town_City","type":"string"},
			"yoda":{"path":"townCity","type":"string","nullable":true}
		},
		{
			"crm":{"path":"Postcode","type":"string"},
			"yoda":{"path":"postcode","type":"string","nullable":true}
		},
		{
			"crm":{"path":"Country","type":"string"},
			"yoda":{"path":"country","type":"string","nullable":true}
		},
		{
			"crm":{"path":"Region","type":"string"},
			"yoda":{"path":"region","type":"string","nullable":true}
		},
		{
			"crm":{"path":"Address_Line_Two","type":"string"},
			"yoda":{"path":"addressLineTwo","type":"string","nullable":true}
		},
		{
			"crm":{"path":"id","type":"string"},
			"yoda":{"path":"crmId","type":"string","nullable":true}
		},
		{
			"crm":{"path":"company_yoda_id","type":"string"},
			"yoda":{"path":"company","type":"string","nullable":true}
		}
	}
},
"path":
{
	"Accounts":"companies",
	"Contacts":"contacts",
	"Addresses":"addresses",
	"companies":"Accounts",
	"contacts":"Contacts",
	"addresses":"Addresses",
	"sales-negotiations":"sales-negotiations",
	"sales-orders":"sales-orders",
	"purchase-orders":"purchase-orders",
	"payment-terms":"payment-terms",
	"delivery-terms":"delivery-terms",
	"users":"users"
}
};
//
return settings;
