// /**
//  * FUNCTION: Update New Customer Status in Leads
//  * ─────────────────────────────────────────────────────────────
//  * @desc    Evaluates a set of onboarding checklist fields on a
//  *          Lead and sets the New_Customer_Status field to
//  *          "Not Started", "In Progress", or "Complete".
//  *
//  *          The fields checked depend on Lead_Prospect_Type:
//  *            Customer          → customer checklist fields
//  *            Supplier          → supplier checklist fields
//  *            Customer&Supplier → both checklists combined
//  *
//  * @trigger Workflow: Leads — On Edit (any checklist field changes)
//  *
//  * @param   record_id {String} — The CRM Lead record ID
//  *
//  * @returns {void}
//  *
//  * @depends none
//  *
//  * @flow
//  *   1. Fetch Lead and read Lead_Prospect_Type
//  *   2. Read all relevant checklist fields
//  *   3. Evaluate: all null → "Not Started"
//  *                all populated → "Complete"
//  *                mixed → "In Progress"
//  *   4. Update New_Customer_Status on the Lead
//  *
//  * @authors  Prince Rajput (original)
//  *
//  * @updated  DD/MM/YYYY — Description of change
//  * ─────────────────────────────────────────────────────────────
//  */
response = zoho.crm.getRecordById("Leads",record_id);
lead_prospect_type = response.get("Lead_Prospect_Type");
//
// Read all checklist fields
New_Customer_Form_Received = response.get("New_Customer_Form_Received");
New_Customer_Form_Checks_Completed = response.get("New_Customer_Form_Checks_Completed");
Currency_Confirmed = response.get("Currency_Confirmed");
Payment_Terms_Confirmed = response.get("Payment_Terms_Confirmed");
Credit_Limit_Confirmed = response.get("Credit_Limit_Confirmed");
Delivery_Terms_Confirmed = response.get("Delivery_Terms_Confirmed");
New_Line_Form_Returned = response.get("New_Line_Form_Returned");
Stickers_Required = response.get("Stickers_Required");
EUR_1_Forms_Required = response.get("EUR_1_Forms_Required");
Contract_Review_Complete = response.get("Contract_Review_Complete");
Terms_Conditions_Review_Complete = response.get("Terms_Conditions_Review_Complete");
Packing_Instructions_Review_Complete = response.get("Packing_Instructions_Review_Complete");
Delivery_Instructions_Review_Complete = response.get("Delivery_Instructions_Review_Complete");
References_Received = response.get("References_Received");
New_Supplier_Form_Received = response.get("New_Supplier_Form_Received");
New_Supplier_Form_Checks_Completed = response.get("New_Supplier_Form_Checks_Completed");
New_Line_Form_Received = response.get("New_Line_Form_Received");
New_Customer_Form_Returned = response.get("New_Customer_Form_Returned");
References_Sent = response.get("References_Sent");
//
// Named booleans for readability
customer_fields_empty = (New_Customer_Form_Received == null && New_Customer_Form_Checks_Completed == null && Currency_Confirmed == null && Payment_Terms_Confirmed == null && Credit_Limit_Confirmed == null && Delivery_Terms_Confirmed == null && New_Line_Form_Returned == null && Contract_Review_Complete == null && Terms_Conditions_Review_Complete == null && Packing_Instructions_Review_Complete == null && Delivery_Instructions_Review_Complete == null && References_Received == null);
customer_fields_complete = (New_Customer_Form_Received != null && New_Customer_Form_Checks_Completed != null && Currency_Confirmed != null && Payment_Terms_Confirmed != null && Credit_Limit_Confirmed != null && Delivery_Terms_Confirmed != null && New_Line_Form_Returned != null && Contract_Review_Complete != null && Terms_Conditions_Review_Complete != null && Packing_Instructions_Review_Complete != null && Delivery_Instructions_Review_Complete != null && References_Received != null);
supplier_fields_empty = (New_Supplier_Form_Received == null && New_Supplier_Form_Checks_Completed == null && New_Line_Form_Received == null && New_Customer_Form_Returned == null && References_Sent == null);
supplier_fields_complete = (New_Supplier_Form_Received != null && New_Supplier_Form_Checks_Completed != null && New_Line_Form_Received != null && New_Customer_Form_Returned != null && References_Sent != null);
//
if(lead_prospect_type == "Customer")
{
	if(customer_fields_empty)
	{
		update_rec = zoho.crm.updateRecord("Leads",record_id,{"New_Customer_Status":"Not Started"});
		info update_rec;
	}
	else if(customer_fields_complete)
	{
		update_rec = zoho.crm.updateRecord("Leads",record_id,{"New_Customer_Status":"Complete"});
		info update_rec;
	}
	else
	{
		update_rec = zoho.crm.updateRecord("Leads",record_id,{"New_Customer_Status":"In Progress"});
		info update_rec;
	}
}
if(lead_prospect_type == "Supplier")
{
	if(supplier_fields_empty)
	{
		update_rec = zoho.crm.updateRecord("Leads",record_id,{"New_Customer_Status":"Not Started"});
		info update_rec;
	}
	else if(supplier_fields_complete)
	{
		update_rec = zoho.crm.updateRecord("Leads",record_id,{"New_Customer_Status":"Complete"});
		info update_rec;
	}
	else
	{
		update_rec = zoho.crm.updateRecord("Leads",record_id,{"New_Customer_Status":"In Progress"});
		info update_rec;
	}
}
if(lead_prospect_type == "Customer & Supplier")
{
	if(customer_fields_empty && supplier_fields_empty)
	{
		update_rec = zoho.crm.updateRecord("Leads",record_id,{"New_Customer_Status":"Not Started"});
		info update_rec;
	}
	else if(customer_fields_complete && supplier_fields_complete)
	{
		update_rec = zoho.crm.updateRecord("Leads",record_id,{"New_Customer_Status":"Complete"});
		info update_rec;
	}
	else
	{
		update_rec = zoho.crm.updateRecord("Leads",record_id,{"New_Customer_Status":"In Progress"});
		info update_rec;
	}
}
