// /**
//  * FUNCTION: update_to_primary
//  * ─────────────────────────────────────────────────────────────
//  * @desc    Ensures only one Address of each type (Billing or
//  *          Delivery) is marked as Primary per Account. When an
//  *          Address is set to Primary, this function finds all
//  *          sibling Addresses of the same type and sets their
//  *          Primary field to false.
//  *
//  * @trigger Workflow: Addresses — On Edit (Primary set to true)
//  *
//  * @param   id {String} — The Address record ID being set as Primary
//  *
//  * @returns {void}
//  *
//  * @depends none
//  *
//  * @flow
//  *   1. Fetch the triggering Address and read its Type
//  *   2. Fetch all other Addresses linked to the same Account
//  *   3. For each sibling with the same Type and Primary = true,
//  *      set Primary = false and update the record
//  *
//  * @authors  Jake Holland (original)
//  *
//  * @updated  DD/MM/YYYY — Description of change
//  * ─────────────────────────────────────────────────────────────
//  */
response = zoho.crm.getRecordById("Addresses",id);
orginal_type = response.get("Type");
//
related_addresses = zoho.crm.getRelatedRecords("Addresses","Accounts",response.get("Account_Name").get("id"));
for each  rec in related_addresses
{
	if(rec.get("id") != id)
	{
		rec_type = rec.get("Type");
		rec_primary = rec.get("Primary");
		//
		// If this sibling is the same type and currently Primary, demote it
		if(rec_primary == true && rec_type == orginal_type)
		{
			mp = Map();
			mp.put("Primary",false);
			info rec.get("id");
			info zoho.crm.updateRecord("Addresses",rec.get("id"),mp);
		}
	}
}
