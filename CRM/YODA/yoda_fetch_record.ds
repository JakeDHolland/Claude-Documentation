// /**
//  * FUNCTION: yoda_fetch_record
//  * ─────────────────────────────────────────────────────────────
//  * @desc    Fetches one or more records from a Yoda API module
//  *          using a criteria query string. Logs every request
//  *          to Audit_Logs for traceability.
//  *
//  * @trigger Called internally — not triggered directly by CRM
//  *
//  * @param   module  {String} — CRM module name used to look up
//  *                             the Yoda endpoint e.g. "Accounts"
//  * @param   critera {String} — Yoda query string e.g.
//  *                             "surname=Holland"
//  *                             "label=Net+30"
//  *
//  * @returns {Map} — Raw Yoda API response containing a "data" list
//  *
//  * @depends yoda_get_intergration_settings
//  *          yoda_call_api
//  *          create_log
//  *
//  * @flow
//  *   1. Look up the Yoda endpoint path for the module
//  *   2. Build query string: endpoint?criteria&order[created]=desc
//  *   3. Call Yoda API (GET)
//  *   4. Log the request and response to Audit_Logs
//  *   5. Return the raw response map
//  *
//  * @authors  Jake Holland (original)
//  *
//  * @updated  DD/MM/YYYY — Description of change
//  * ─────────────────────────────────────────────────────────────
//  */
settings = standalone.yoda_get_intergration_settings();
yoda_module = settings.get("path").get(module);
//
// Build the full fetch path with criteria and default sort order
fetch_path = yoda_module + "?" + critera + "&order[created]=desc";
//
headers = Map();
body = Map();
//
info "Path:" + fetch_path;
info "headers:" + headers;
response = standalone.yoda_call_api(fetch_path,"GET",body,headers);
//
// Log the request for audit and debugging purposes
create_log = standalone.create_log("INFO","Fetch Critera: " + fetch_path,response,module);
//
return response;
