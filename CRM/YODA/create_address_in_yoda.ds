// /**
//  * FUNCTION: create_address_in_yoda
//  * ─────────────────────────────────────────────────────────────
//  * @desc    Syncs a single CRM Address record to Yoda. Looks up
//  *          the parent Account's Yoda_Id to build the company
//  *          link. Exits silently if the parent Account has not
//  *          yet been synced to Yoda — yoda_trigger_sync handles
//  *          that ordering when run on the Account.
//  *
//  * @trigger Workflow: Addresses — On Create or Edit
//  *
//  * @param   record_id {String} — The CRM Address record ID
//  *
//  * @returns {void}
//  *
//  * @depends yoda_get_intergration_settings
//  *          process_address_before_conversion
//  *          yoda_sync_record
//  *
//  * @flow
//  *   1. Fetch Address record
//  *   2. Load integration settings
//  *   3. Normalise address type for Yoda format
//  *   4. Read parent Account and check its Yoda_Id
//  *   5. Exit silently if parent Account not yet in Yoda
//  *   6. Build company_yoda_id link from Account Yoda_Id
//  *   7. Inject company link and sync Address → Yoda (POST or PUT)
//  *
//  * @authors  Jake Holland (original)
//  *           Prince Rajput (contributor)
//  *
//  * @updated  DD/MM/YYYY — Description of change
//  * ─────────────────────────────────────────────────────────────
//  */
module = "Addresses";
record_info = zoho.crm.getRecordById(module,record_id);
//
settings = standalone.yoda_get_intergration_settings();
yoda_path = settings.get("credentials").get("root");
//
// Normalise the address type integer before translation
record_info = standalone.process_address_before_conversion(record_info);
record_info = record_info.toMap();
//
// Look up the parent Account's Yoda_Id so we can link the Address to the company in Yoda
account = record_info.get("Account_Name");
if(account != null)
{
	account_id = account.get("id");
	account_info = zoho.crm.getRecordById("Accounts",account_id);
	yoda_id = account_info.get("Yoda_Id");
	info "yoda_id: " + yoda_id;
	//
	// If the parent Account has no Yoda_Id it hasn't been synced yet — skip.
	// yoda_trigger_sync will handle this Address when it runs on the Account.
	if(yoda_id != null)
	{
		info "hit";
		yoda_path = settings.get("credentials").get("root");
		company_link = "/" + yoda_path + "companies/" + yoda_id;
		info "company_link: " + company_link;
		record_info.put("company_yoda_id", company_link);
		//
		info record_info;
		//
		trigger = standalone.yoda_sync_record(module,record_info);
		info trigger;
	}
}
