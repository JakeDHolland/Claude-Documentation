// /**
//  * FUNCTION: yoda_create_address_record
//  * ─────────────────────────────────────────────────────────────
//  * @desc    Creates a new Address record in the CRM Addresses
//  *          module. Used by Create_Address_from_Account to
//  *          persist address data from Account fields into
//  *          individual Address records.
//  *
//  * @trigger Called internally — not triggered directly by CRM
//  *
//  * @param   address {Map} — Address data map with keys:
//  *                          street, street2, city, province,
//  *                          postal_code, country, type,
//  *                          account_id, Name, Primary,
//  *                          Do_Not_Allow_Record_to_Sync
//  *
//  * @returns {String} — New Address record ID, or
//  *                     "Unable to create Address" on failure
//  *
//  * @depends none
//  *
//  * @flow
//  *   1. Extract fields from input map
//  *   2. Build CRM Address record map
//  *   3. Create Address record in CRM (with workflow trigger)
//  *   4. Return new record ID or error string
//  *
//  * @authors  Jake Holland (original)
//  *           Sam Prabhu (contributor)
//  *
//  * @updated  DD/MM/YYYY — Description of change
//  * ─────────────────────────────────────────────────────────────
//  */
address = address.toMap();
//
street = address.get("street");
street_2 = address.get("street2");
city = address.get("city");
province = address.get("province");
postal_code = address.get("postal_code");
country = address.get("country");
type = address.get("type");
account_id = address.get("account_id");
address_name = address.get("Name");
primary = IFNULL(address.get("Primary"),FALSE);
do_not_sync = address.get("Do_Not_Allow_Record_to_Sync");
//
// Build the CRM Address record map
Address = Map();
Address.put("Type","Billing");
Address.put("Street_1",street);
Address.put("Account_Name",account_id);
Address.put("Address_Line_Two",street_2);
Address.put("Town_City",city);
Address.put("Postcode",postal_code);
Address.put("Country",country);
Address.put("Type",type);
Address.put("Name",address_name);
Address.put("Primary",primary);
Address.put("Do_Not_Allow_Record_to_Sync", do_not_sync);
//
info Address;
response = zoho.crm.createRecord("Addresses",Address,{"trigger":{"workflow"}});
info response;
if(response.containsKey("id"))
{
	address_id = response.get("id");
}
//
if(address_id == null)
{
	return "Unable to create Address";
}
else
{
	return address_id;
}
