// /**
//  * FUNCTION: yoda_trigger_sync
//  * ─────────────────────────────────────────────────────────────
//  * @desc    Orchestrates a full sync of an Account and all its
//  *          related Contacts and Addresses to Yoda. Waits 5s
//  *          before syncing to allow concurrent workflows to
//  *          confirm their Yoda_Id is still null, preventing
//  *          duplicate records being created in Yoda.
//  *
//  * @trigger Workflow: Accounts — On Create
//  *          Button: "Sync to Yoda" on Account detail view
//  *
//  * @param   account_id {String} — The CRM Account record ID
//  *
//  * @returns {String} — Empty string on completion or early exit
//  *
//  * @depends process_account_before_conversion
//  *          yoda_sync_record
//  *          yoda_get_intergration_settings
//  *          process_address_before_conversion
//  *
//  * @flow
//  *   1. Fetch Account and normalise fields for Yoda format
//  *   2. Delay 5s to avoid race conditions with concurrent workflows
//  *   3. Sync Account → Yoda company (POST or PUT)
//  *   4. Exit early if Account sync fails
//  *   5. Re-fetch Account to read newly assigned Yoda_Id
//  *   6. Find all related Contacts where Yoda_Id is null
//  *   7. Inject company_yoda_id link and sync each Contact
//  *   8. Find all related Addresses where Yoda_Id is null
//  *          and Do_Not_Allow_Record_to_Sync != "Yes"
//  *   9. Normalise and sync each Address → Yoda address
//  *
//  * @authors  Jake Holland (original)
//  *           Prince Rajput (contributor)
//  *
//  * @updated  DD/MM/YYYY — Description of change
//  * ─────────────────────────────────────────────────────────────
//  */
record_info = zoho.crm.getRecordById("Accounts",account_id);
//
record_info = standalone.process_account_before_conversion(record_info);
//
// We start with a delay so the functions on creation of a Contact and Address
// have time to confirm the Yoda_Id is empty on the related Account.
// This means they will not try to sync independently — this function handles it
// so we are sure we have everything we need before syncing.
delay_url = "https://postman-echo.com/delay/5";
delayResponseCall = invokeurl
[
	url :delay_url
	type :GET
];
//
// =========Create Account===========
trigger = standalone.yoda_sync_record("Accounts",record_info);
info trigger;
//
// If there was a failure in the sync of the account, end the function
if(trigger != "Successfull")
{
	return "";
}
//
// Re-fetch so we can read the newly assigned Yoda_Id and build the company link
// to inject into Contact and Address mappings
settings = standalone.yoda_get_intergration_settings();
yoda_path = settings.get("credentials").get("root");
account_info = zoho.crm.getRecordById("Accounts",account_id);
yoda_id = account_info.get("Yoda_Id");
company_link = "/" + yoda_path + "companies/" + yoda_id;
//
// =========Create Contacts===========
related_contacts = zoho.crm.searchRecords("Contacts","(Account_Name:equals:" + account_id + ")");
contact_size = related_contacts.size();
info contact_size;
info related_contacts;
//
// If the Account was created with no linked Contacts, skip the contact sync
if(contact_size != 0)
{
	for each  contact in related_contacts
	{
		contact_id = contact.get("id");
		yoda_id = contact.get("Yoda_Id");
		info contact_id;
		//
		// Skip Contacts already synced to Yoda
		if(yoda_id == null)
		{
			// Inject the company link so the Contact can be linked to the Account in Yoda
			contact.put("company_yoda_id",company_link);
			//
			trigger = standalone.yoda_sync_record("Contacts",contact);
		}
	}
}
//
// =========Create Addresses===========
related_addresses = zoho.crm.searchRecords("Addresses","(Account_Name:equals:" + account_id + ")");
address_size = related_addresses.size();
//
if(address_size != 0)
{
	for each  address in related_addresses
	{
		address_id = address.get("id");
		yoda_id = address.get("Yoda_Id");
		do_not_sync = address.get("Do_Not_Allow_Record_to_Sync");
		//
		// Skip Addresses already synced or explicitly excluded from sync
		if(yoda_id == null && do_not_sync != "Yes")
		{
			address = standalone.process_address_before_conversion(address);
			//
			// Inject the company link so the Address can be linked to the Account in Yoda
			address.put("company_yoda_id",company_link);
			//
			trigger = standalone.yoda_sync_record("Addresses",address);
		}
	}
}
return "";
