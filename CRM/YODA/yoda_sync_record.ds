// Original author - Jake Holland
// Contributing developers:
//
// @input.module - the crm module name the record belongs to e.g. Accounts
// @input.record_info - the CRM record info to be processed. Any modifications to the map should be done before it reaches this point.
//
//
record_info = record_info.toMap();
record_id = record_info.get("id");
// fetch the yoda mapping for Accounts
settings = standalone.yoda_get_intergration_settings();
mapping = settings.get("mapping").get(module);
//info "mapping: " +mapping;
//
//
// create log of sync attempt
create_log = standalone.create_log("INFO","Syncing " + module + " - " + record_id,record_info,module);
//
//
output_data = Map();
// translate to yoda format
translation_result = standalone.translate(record_info,mapping,"crm","yoda",output_data,true);
output_data = translation_result.get("result");
errors = translation_result.get("errors");
warnings = translation_result.get("warnings");
//
//remove empty lookup fields since they cannot be ""
company = output_data.get("company");
if(company == "")
{
	output_data.remove("company");
}
info "output_data: " + output_data;
// info "output_data empty: " + output_data.isEmpty();
// info "errors empty: " + errors.isEmpty();
// info "warnings empty:" + warnings.isEmpty();
if(output_data.isEmpty() == true || errors.isEmpty() != true || warnings.isEmpty() != true)
{
	info "ERROR: Unable to Translate - " + module + " - " + record_id;
	create_log = standalone.create_log("ERROR","Unable to Translate - " + record_id,translation_result,module);
	return "ERROR";
}
//
//build path
path = settings.get("path").get(module);
yoda_id = record_info.get("Yoda_Id");
yoda_api_call = "POST";
sync_type = "Create";
// if yoda_id is not empty the record has been synced to Yoda already so we want to update and not create. This needs a slightly different path
// we also need to use a PUT api call and not POST
if(yoda_id != null)
{
	path = path + "/" + yoda_id;
	info path;
	yoda_api_call = "PUT";
	sync_type = "Update";
}
//
headers = Map();
//
// Sync to Yoda
info yoda_id;
response = standalone.yoda_call_api(path,yoda_api_call,output_data,headers);
info response;
//
//create log of sync attempt
response_message = response.get("data");
//
//from testing so far only success is stored in the data mapping
if(response_message == null)
{
	info "ERROR: Unable to " + sync_type + " " + module;
	create_log = standalone.create_log("ERROR","Unable to " + sync_type + " " + module + " - " + record_id,response,module);
	return "ERROR";
}
//
// log sucessess
info "Info: Yoda Record " + sync_type + " for " + module + " - " + record_id;
create_log = standalone.create_log("INFO","Successfully " + sync_type + " " + module + " - " + record_id,response,module);
//
// only extract id out if the field is empty. If the field is not it has already been extracted.
if(yoda_id == null)
{
	//add yoda_id to account
	//yoda_id = response.get("data").get("id");
	//yoda id return looks like this "/api/v1/companies/396" so we need to extract the real id out
	yoda_id_string = response.get("data").get("id");
	yoda_id = standalone.yoda_extract_id(yoda_id_string);
	//
	// update account with yoda id
	update = zoho.crm.updateRecord(module,record_id,{"Yoda_Id":yoda_id},{"trigger":{"workflow"}});
	update_id = update.get("id");
	if(update_id == null)
	{
		create_log = standalone.create_log("ERROR","Unable to Set Yoda_ID for " + module + " - " + record_id,response,module);
		return "ERROR";
	}
}
//
//
return "Successfull";
