// /**
//  * FUNCTION: process_account_before_conversion
//  * ─────────────────────────────────────────────────────────────
//  * @desc    Normalises CRM Account field values into the formats
//  *          Yoda's API expects before the record is translated
//  *          and synced. Also resolves lookup IDs for payment
//  *          terms, delivery terms, and the default salesperson
//  *          by querying the Yoda API.
//  *
//  * @trigger Called internally — not triggered directly by CRM
//  *
//  * @param   record_info {Map} — Raw CRM Account record map
//  *
//  * @returns {Map} — Modified record_info ready for translation
//  *
//  * @depends yoda_fetch_record
//  *          fetch_yoda_user_id
//  *
//  * @flow
//  *   1. Convert Dutch_VAT_Term to Yoda enum ("none" / "dutch_vat")
//  *   2. Convert Operating_Region to Yoda region code
//  *   3. Convert Account_Type to lowercase_underscore format
//  *   4. Set Customer / Supplier boolean flags from Lead_Prospect_Type
//  *   5. Look up payment term ID in Yoda and inject as paymentTerm
//  *   6. Look up delivery term ID in Yoda and inject as deliveryTerm
//  *   7. Look up owner's Yoda user ID and inject as defaultSalesperson
//  *
//  * @authors  Jake Holland (original)
//  *
//  * @updated  DD/MM/YYYY — Description of change
//  * ─────────────────────────────────────────────────────────────
//  */
record_info = record_info.toMap();
//
// Yoda only accepts the enum values below — convert from CRM display values
dutch_vat = record_info.get("Dutch_VAT_Term");
if(dutch_vat == "No" || dutch_vat == null || dutch_vat == "")
{
	record_info.put("Dutch_VAT_Term","none");
}
else
{
	record_info.put("Dutch_VAT_Term","dutch_vat");
}
//
// Convert Operating_Region display value to Yoda region code
region_conversion_map = {"UK":"uk","Netherlands":"nl","Other EC":"ec","Other":"other"};
operating_region = record_info.get("Operating_Region");
operating_region_converted = region_conversion_map.get(operating_region);
record_info.put("Operating_Region",operating_region_converted);
//
// Yoda expects account type as lowercase with underscores e.g. "key_account"
account_type = record_info.get("Account_Type").toLowerCase().replaceAll(" ","_").replaceAll("-","_");
record_info.put("Account_Type",account_type);
info "account_type: " + account_type;
//
// Set Customer/Supplier boolean flags and select the correct terms fields
// Customer & Supplier uses Customer terms for Yoda mapping
if(record_info.get("Lead_Prospect_Type") == "Customer")
{
	record_info.put("Customer",true);
	payment_term = record_info.get("Payment_Terms");
	delivery_term = record_info.get("Delivery_Terms");
}
else if(record_info.get("Lead_Prospect_Type") == "Supplier")
{
	record_info.put("Supplier",true);
	payment_term = record_info.get("Supplier_Payment_Terms1");
	delivery_term = record_info.get("Supplier_Delivery_Terms");
}
else if(record_info.get("Lead_Prospect_Type") == "Customer & Supplier")
{
	record_info.put("Customer",true);
	record_info.put("Supplier",true);
	payment_term = record_info.get("Payment_Terms");
	delivery_term = record_info.get("Delivery_Terms");
}
info "Lead_Prospect_Type: " + record_info.get("Lead_Prospect_Type");
//
// Yoda stores payment terms as a lookup ID, not a label string.
// Fetch the matching Yoda record ID by label and inject it.
module = "payment-terms";
encode_payment_term = encodeURL(payment_term);
critera = "label=" + encode_payment_term;
response = standalone.yoda_fetch_record(module,critera);
response = response.toMap();
data = response.get("data");
payment_size = data.size();
if(payment_size == 1)
{
	payment_term_id = data.get(0).get("id");
	record_info.put("paymentTerm",payment_term_id);
}
//
// Fetch delivery term ID from Yoda by label and inject it
module = "delivery-terms";
encode_delivery_term = encodeURL(delivery_term);
critera = "label=" + encode_delivery_term;
response = standalone.yoda_fetch_record(module,critera);
response = response.toMap();
data = response.get("data");
delivery_size = data.size();
if(delivery_size == 1)
{
	delivery_term_id = data.get(0).get("id");
	record_info.put("deliveryTerm",delivery_term_id);
}
//
// Fetch the record owner's Yoda user ID and inject as defaultSalesperson
user_id = record_info.get("Owner").get("id");
yoda_user_id = standalone.fetch_yoda_user_id(user_id);
if(yoda_user_id != "MISSING")
{
	record_info.put("defaultSalesperson",yoda_user_id);
}
//
return record_info;
