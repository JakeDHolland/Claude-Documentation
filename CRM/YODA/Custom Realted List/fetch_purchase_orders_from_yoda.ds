// /**
//  * FUNCTION: fetch_purchase_orders_from_yoda
//  * ─────────────────────────────────────────────────────────────
//  * @desc    Entry point for the Purchase Orders custom related
//  *          list on the Account detail view. Fetches all purchase
//  *          orders from Yoda linked to the Account and returns
//  *          them as XML for CRM to render.
//  *
//  * @trigger Custom Related List: Accounts — Purchase Orders
//  *
//  * @param   record_id {String} — The CRM Account record ID
//  *
//  * @returns {String} — XML string for CRM related list rendering,
//  *                     or empty string if Account has no Yoda_Id
//  *
//  * @depends build_related_list
//  *
//  * @flow
//  *   1. Set module to "Accounts" and yoda_module to "purchase-orders"
//  *   2. Delegate to build_related_list
//  *
//  * @authors  Dash Bunyan (original)
//  *           Jake Holland, Prince Rajput, Owen Kempton (contributors)
//  *
//  * @updated  DD/MM/YYYY — Description of change
//  * ─────────────────────────────────────────────────────────────
//  */
module = "Accounts";
yoda_module = "purchase-orders";
data_xml = standalone.build_related_list(module,record_id,yoda_module);
return data_xml;
